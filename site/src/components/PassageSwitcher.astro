---
import { SUGYOT } from '../rail/sugyot/index.ts';

interface Props {
  /** Id of the passage being read, if any. */
  current?: string;
}

const { current } = Astro.props;

/**
 * Server-rendered, not an island. This replaces the visualization's own tab
 * strip, which was built on its hash router: every entry here is a real link
 * to a real page, so the passages are crawlable and the browser's back button
 * works.
 *
 * A wrapping grid, not a horizontal scroller. It lives inside the stage's
 * hover panel now, and a panel that needs its own scrollbar to show nine
 * items defeats the point of the panel.
 */
const passages = SUGYOT.map((s) => ({
  id: s.id,
  cite: `${s.tractate} ${s.folio}`,
  title: s.title,
  sentences: s.units.length,
}));
---

<nav class="switcher" aria-label="Choose a passage">
  {passages.map((p) => (
    <a
      href={`/sugya/${p.id}`}
      class={p.id === current ? 'on' : undefined}
      aria-current={p.id === current ? 'page' : undefined}
    >
      <span class="cite">{p.cite}</span>
      <span class="title">{p.title}</span>
      <span class="count">{p.sentences} sentences</span>
    </a>
  ))}
</nav>

<style>
  .switcher {
    display: grid;
    /* 160px, not 200: at a 390px phone width that yields two columns, so the
       nine cards take five rows (~360px) instead of nine (~630px) and the
       panel fits the clamped viewport. Measured 2026-09-16: one column put
       the panel's bottom at 926px in an 844px viewport. */
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.5rem;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid rgba(253, 194, 35, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  a:hover {
    border-color: rgba(253, 194, 35, 0.45);
    background: rgba(255, 255, 255, 0.06);
  }

  a.on {
    border-color: var(--dt-cyan);
    background: rgba(34, 211, 238, 0.08);
  }

  .cite {
    font-family: var(--dt-condensed);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dt-champagne);
  }

  a.on .cite {
    color: var(--dt-cyan);
  }

  .title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dt-chrome-fg);
    line-height: 1.3;
  }

  .count {
    font-size: 0.6875rem;
    color: var(--dt-chrome-dim);
  }
</style>
