---
import SearchBar from './SearchBar';

/** The search index covers docs, so the nav search only appears there. */
const isDocs = Astro.url.pathname.startsWith('/docs');
const path = Astro.url.pathname;
const isHome = path === '/' || path.startsWith('/sugya');

// The standing answer to "what am I looking at". It sits beside the brand and
// not in the link row on purpose: it is a question about the site, not a
// fourth section of it, and the row's four labels are already measured to the
// edge of a 390px bar.
const isAbout = path.startsWith('/about');

const links = [
  { href: '/', label: 'Sugyascade', active: isHome },
  // The same drawing, fed a file the reader brings. Beside Sugyascade because
  // that is what it is a second door to, not a section of its own. A fourth
  // full-length label does not fit a 390px bar beside the wordmark, so this
  // one carries a short form for the nav's own 640px breakpoint.
  { href: '/byo', label: 'Bring Your Own', short: 'Bring', active: path.startsWith('/byo') },
  { href: '/docs', label: 'Docs', active: path.startsWith('/docs') },
  { href: '/blog', label: 'Blog', active: path.startsWith('/blog') },
];
---

<nav>
  <div class="bar">
    <div class="brand">
      <a href="/" class="logo" aria-label="Derech Tevunos, home">
        <img src="/mark-64.png" alt="" width="64" height="64" />
        <span class="wordmark">Derech Tevunos</span>
      </a>
      {/* A sibling of the logo, never a child: an anchor inside an anchor is
          invalid and the inner one stops being clickable. */}
      <a
        href="/about"
        class={`what${isAbout ? ' on' : ''}`}
        aria-current={isAbout ? 'page' : undefined}
      >(What is this?)</a>
    </div>

    {isDocs && (
      <div class="search">
        <SearchBar client:load />
      </div>
    )}

    <div class="links">
      {links.map((l) => (
        <a href={l.href} class={l.active ? 'on' : undefined} aria-current={l.active ? 'page' : undefined}>
          {l.short ? (
            <>
              <span class="wide">{l.label}</span><span class="narrow">{l.short}</span>
            </>
          ) : (
            l.label
          )}
        </a>
      ))}
      <a
        href="https://github.com/deusaquilus/derech-tevunos"
        class="src"
        rel="noopener"
      >
        Source
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7" />
          <path d="M7 7h10v10" />
        </svg>
      </a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(28, 26, 23, 0.97);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--dt-chrome-rule);
    /* 0.625rem of chrome around a ~30px mark gives a ~50px bar, which is the
       sticky-nav range readers expect on a content site. Past ~64px it starts
       reading as a marketing header. */
    padding: 0.625rem 0;
  }

  .bar {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    /* Centred, not `baseline`: `.logo` is itself a flex box whose first item is
       the mark, so its baseline is the image's bottom edge, not the wordmark's
       baseline — aligning to it drops this text below the bar's centre. */
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    min-width: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* The quietest thing in the bar, deliberately. It is an aside to the brand,
     so it sits on the brand's baseline at the dimmest chrome colour and only
     picks up the champagne on hover — the same hover the section links use, so
     it is discoverable without competing with them for attention. */
  .what {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--dt-chrome-dim);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .what:hover {
    color: var(--dt-champagne);
  }

  .what.on {
    color: var(--dt-cyan);
  }

  /* There is no room for this between the width where the link row goes back
     to its full-length labels and the width where the bar is wide enough to
     carry both. Measured 2026-09-16 by stepping the viewport 5px at a time
     from 620 to 1000: with this link the bar's content overflows its box from
     645px through 755px and fits from 760px up, so the true fitting threshold
     lies in (755, 760]. Below 641px the links wear their short forms and there
     is room again, verified down to 360px.

     Note for whoever measures this next: with the link hidden, the same scan
     still overflows from 645px to 660px. That 16px band is pre-existing, it is
     the four full-length labels against the wordmark, and this rule neither
     causes it nor fixes it. */
  @media (min-width: 641px) and (max-width: 759px) {
    .what {
      display: none;
    }
  }

  .logo img {
    height: 1.85rem;
    width: auto;
  }

  /* F1, "tuned metallic sans" (settled 2026-09-16). Weight 500 and open
     tracking, not 700 and tight: bold saturated gold on ink reads as a blocky
     mass. The solid `--dt-gold` is spent on the primary action instead, so the
     loudest gold on any page is the thing to click, not the logo.
     `translateZ(0)` is load-bearing — see the note in tokens.css. */
  .wordmark {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1;
    background: var(--dt-metal-sm);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transform: translateZ(0);
  }

  .search {
    flex: 1;
    max-width: 420px;
    margin: 0 auto;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-left: auto;
    font-size: 0.95rem;
  }

  .links a {
    color: var(--dt-chrome-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .links a:hover {
    color: var(--dt-champagne);
  }

  .links a.on {
    color: var(--dt-cyan);
  }

  .links a.src {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .links a.src svg {
    width: 0.85em;
    height: 0.85em;
    opacity: 0.85;
  }

  /* A link that carries a short form shows one or the other, never both. */
  .narrow {
    display: none;
  }

  @media (max-width: 900px) {
    .search {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .bar {
      padding: 0 1rem;
      gap: 0.75rem;
    }

    .wordmark {
      font-size: 1.05rem;
    }

    .links {
      gap: 0.9rem;
      font-size: 0.82rem;
    }

    .links a.src {
      display: none;
    }

    .wide {
      display: none;
    }

    .narrow {
      display: inline;
    }
  }

  /* The fourth link does not fit beside the wordmark on a phone. Measured
     2026-09-16 at 390px: logo 166 (mark 30 + wordmark ~126) + links 206 +
     gap 12 + padding 32 = 416 against 390 available, and 360px is worse.
     Shrinking type and gaps instead lands at 391 — one pixel over, which is
     not a margin. So below 430px the brand is the mark alone: it is already
     the site's logo mark in its own right (it is the favicon at five sizes,
     and `mascott/just_beard_goggles.png` is where both come from), and the
     wordmark is the first thing a phone can spare. 390px after: 290 used. */
  @media (max-width: 430px) {
    .wordmark {
      display: none;
    }
  }
</style>
