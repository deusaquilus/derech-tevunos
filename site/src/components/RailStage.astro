---
import PassageSwitcher from './PassageSwitcher.astro';
import Rail from './Rail';
import StageShell from './StageShell.astro';
import { movementsOf, type Sugya } from '../rail/sugya.ts';
import { markupToHtml } from '../rail/markup.ts';

interface Props {
  sugya: Sugya;
}

/**
 * A shipped passage on the stage.
 *
 * The chrome — the strip, the overlaying panel, the sheet region and every
 * measurement behind them — is `StageShell.astro`. What is here is only what
 * is true of a passage the site ships: its cite and counts in the strip, its
 * authored `hint`, the switcher to its siblings, and the island that draws it.
 * `ByoStage.astro` wears the same shell with a reader's own file instead.
 *
 * The three strip texts use the shell's `dt-strip-*` global classes rather
 * than names of their own: slotted content does not receive the shell's
 * scope, and the byo route's React strip has to paint identically.
 */
const { sugya } = Astro.props;
const cite = `${sugya.tractate} ${sugya.folio}`;
const movements = movementsOf(sugya).length;
const hintHtml = sugya.hint === undefined ? undefined : markupToHtml(sugya.hint);
---

<StageShell moreLabel="passages &amp; key" moreTitle="Show the passages and the key to the drawing">
  <Fragment slot="line">
    <span class="dt-strip-cite">{cite}</span>
    <span class="dt-strip-title">{sugya.title}</span>
    <span class="dt-strip-meta">{sugya.units.length} sentences · {movements} movements</span>
  </Fragment>

  <Fragment slot="panel">
    {hintHtml && <p class="hint" set:html={hintHtml} />}
    <PassageSwitcher current={sugya.id} />
    {/* The legend's host. Empty in the HTML; the island fills it. */}
    <div id="railLegend"></div>
    <div class="links">
      <a href="/sugya">All passages</a>
      <a href="/byo">Bring your own</a>
      <a href="/docs/text/chapter-09">The chapter 9 vocabulary</a>
      <a href="/docs">The text</a>
    </div>
  </Fragment>

  <Rail id={sugya.id} legendHost="railLegend" client:only="react" />
</StageShell>

<style>
  .hint {
    margin: 0 0 0.9rem;
    max-width: 78ch;
    font-size: 0.9rem;
    line-height: 1.6;
    font-weight: 400;
    color: var(--dt-muted);
  }

  .hint :global(b) {
    font-weight: 600;
    color: var(--dt-brass);
  }

  .hint :global(i) {
    font-style: italic;
    color: var(--dt-fg);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--dt-rule);
    font-size: 0.8125rem;
  }

  .links a {
    color: var(--dt-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--dt-brass);
  }
</style>
