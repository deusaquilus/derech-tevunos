---
import PassageSwitcher from './PassageSwitcher.astro';
import Rail from './Rail';
import { movementsOf, type Sugya } from '../rail/sugya.ts';
import { markupToHtml } from '../rail/markup.ts';

interface Props {
  sugya: Sugya;
}

/**
 * The rail, owning the viewport.
 *
 * Two layout facts, both load-bearing:
 *
 *   1. THE SHEET IS THE ONLY THING THAT SCROLLS. The page is clamped
 *      (`body.dt-stage` in Layout.astro), this component fills `main`, and
 *      `.stage-sheet` takes the remaining height with `overflow-y: auto`.
 *      Wheel and drag over the drawing move the drawing; nothing under it
 *      can move. The rail's three `position: sticky` elements — the
 *      state-of-play strip, the foot control and the reveal dock — all attach
 *      to this scroller, which is why it also declares `container-type: size`:
 *      the dock's height is written in `cqh` against it.
 *
 *   2. THE HEADER IS A STRIP THAT EXPANDS OVER THE SHEET, NOT ABOVE IT. When
 *      collapsed it is one 40px line — cite, title, counts. Hovering, focusing
 *      or tapping it reveals a panel with the passage switcher. The panel is
 *      absolutely positioned so opening it never changes the sheet's height:
 *      the controller measures row geometry, and a header that pushed the
 *      sheet down would re-measure every rail and elbow on every hover.
 */
const { sugya } = Astro.props;
const cite = `${sugya.tractate} ${sugya.folio}`;
const movements = movementsOf(sugya).length;
const hintHtml = sugya.hint === undefined ? undefined : markupToHtml(sugya.hint);
---

<div class="stage">
  <header class="strip" id="railStrip">
    <button
      class="line"
      type="button"
      aria-expanded="false"
      aria-controls="railPanel"
      title="Show the passages"
    >
      <span class="cite">{cite}</span>
      <span class="title">{sugya.title}</span>
      <span class="meta">{sugya.units.length} sentences · {movements} movements</span>
      <span class="more" aria-hidden="true">
        passages
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </span>
    </button>

    <div class="panel" id="railPanel">
      {hintHtml && <p class="hint" set:html={hintHtml} />}
      <PassageSwitcher current={sugya.id} />
      <div class="links">
        <a href="/sugya">All passages</a>
        <a href="/docs/text/chapter-09">The chapter 9 vocabulary</a>
        <a href="/docs">The text</a>
      </div>
    </div>
  </header>

  <div class="stage-sheet sugya-sheet" id="railSheet">
    <Rail id={sugya.id} client:only="react" />
  </div>
</div>

<script>
  // Hover opens the panel via CSS. This script covers what CSS cannot: a tap
  // on a touch screen, Escape, a click elsewhere, and — the important one —
  // the moment the reader starts using the drawing, which closes the panel so
  // it never sits over the thing they are looking at.
  const strip = document.getElementById('railStrip');
  const line = strip?.querySelector<HTMLButtonElement>('.line');
  const sheet = document.getElementById('railSheet');

  if (strip && line && sheet) {
    const set = (open: boolean): void => {
      strip.classList.toggle('open', open);
      line.setAttribute('aria-expanded', String(open));
    };

    line.addEventListener('click', () => set(!strip.classList.contains('open')));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });

    document.addEventListener('pointerdown', (e) => {
      if (!strip.contains(e.target as Node)) set(false);
    });

    // Any engagement with the sheet clamps the stage: the panel goes away and
    // the reader has the whole drawing. `passive` because we never cancel.
    for (const type of ['wheel', 'pointerdown', 'touchstart'] as const) {
      sheet.addEventListener(type, () => set(false), { passive: true });
    }
  }
</script>

<style>
  .stage {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    background: var(--dt-surface);
  }

  /* ── The strip ── */

  /* The strip is the paper, one step deeper than the sheet, with a hairline
     under it — a page edge, not a bar. It used to be ink with champagne caps
     and a cyan hover, which made it a third palette between the gold nav and
     the white sheet; on greige the whole region below the nav is one paper. */
  .strip {
    position: relative;
    z-index: 20;
    flex: none;
    border-bottom: 1px solid var(--dt-rule);
    background: var(--dt-surface-deep);
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    width: 100%;
    height: 40px;
    padding: 0 1.25rem;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .cite {
    font-family: var(--dt-condensed);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dt-brass);
    white-space: nowrap;
  }

  .title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--dt-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .meta {
    font-family: var(--dt-condensed);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--dt-muted);
    white-space: nowrap;
  }

  .more {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--dt-condensed);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dt-muted);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .more svg {
    width: 0.9em;
    height: 0.9em;
    transition: transform 0.18s ease;
  }

  .strip:hover .more,
  .strip:focus-within .more,
  .strip.open .more {
    color: var(--dt-brass);
  }

  .strip:hover .more svg,
  .strip:focus-within .more svg,
  .strip.open .more svg {
    transform: rotate(180deg);
  }

  /* ── The panel: absolutely positioned so the sheet never moves ── */

  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 1rem 1.25rem 1.25rem;
    /* The page is clamped, so a panel taller than what is left of the
       viewport would simply be cut off. Cap it and let it scroll inside
       itself — with the scrollbar hidden, like the sheet. The 90px is the
       nav plus this strip. */
    max-height: calc(100dvh - 90px);
    overflow-y: auto;
    scrollbar-width: none;
    background: var(--dt-surface);
    border-bottom: 1px solid var(--dt-rule);
    box-shadow: 0 16px 40px rgba(42, 38, 34, 0.18);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0s linear 0.18s;
  }

  .strip:hover .panel,
  .strip:focus-within .panel,
  .strip.open .panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  .hint {
    margin: 0 0 0.9rem;
    max-width: 78ch;
    font-size: 0.9rem;
    line-height: 1.6;
    font-weight: 400;
    color: var(--dt-muted);
  }

  .hint :global(b) {
    font-weight: 600;
    color: var(--dt-brass);
  }

  .hint :global(i) {
    font-style: italic;
    color: var(--dt-fg);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--dt-rule);
    font-size: 0.8125rem;
  }

  .links a {
    color: var(--dt-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--dt-brass);
  }

  /* ── The sheet: the one scroll container ── */

  .stage-sheet {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    /* Lets the rail dock size itself in `cqh` against this scroller. */
    container-type: size;
    /* The article fills this region edge to edge (`.sheet` in the rail's
       stylesheet: no border, no radius, no width cap, min-height 100%). The
       region paints the SAME `--surface` the article does, so where the
       article ends — which, with min-height 100%, is never above the fold —
       there is no seam. `.sugya-sheet` would otherwise paint the stone
       `--page` colour here and show as a frame. No padding: padding was the
       dark frame. */
    background: var(--surface);
    padding: 0;
    /* No visible scrollbar. A long passage still scrolls under wheel,
       trackpad and touch, and the rail's own reveal keeps the frontier in
       view as sentences are added — so in use there is nothing to scroll
       *for*. Only the chrome is gone. */
    scrollbar-width: none;
  }

  .stage-sheet::-webkit-scrollbar,
  .panel::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 720px) {
    .line {
      gap: 0.6rem;
      padding: 0 0.85rem;
    }

    .meta {
      display: none;
    }

    .panel {
      padding: 0.85rem 0.85rem 1rem;
    }
  }
</style>
