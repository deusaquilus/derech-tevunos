---
import Layout from '../layouts/Layout.astro';
import RailStage from '../components/RailStage.astro';
import { SUGYOT } from '../rail/sugyot/index.ts';

/**
 * The homepage is the rail, and nothing else.
 *
 * It opens on a featured passage rather than on an index, because the
 * visualization is what the site is for, and it opens with the drawing owning
 * the viewport: `bare` clamps the page so the sheet is the only scroll
 * container, and the passage header is a strip that expands on hover rather
 * than a block that takes height. The introduction that used to sit above it
 * is `Hero.astro`, now on the passage index.
 *
 * The featured passage is the first shipped one, which is the shortest of
 * Ramchal's own examples and therefore the one that reads without preamble;
 * `SUGYOT` is in gallery order, so reordering that list rechooses this.
 */
const featured = SUGYOT[0];
if (featured === undefined) throw new Error('No passages: SUGYOT is empty.');
---

<Layout
  title="Derech Tevunos — a sugya as a waterfall of its moves"
  description="Ramchal's Derech Tevunos as a system for labelling dialectical text, and a visualization that draws a sugya as a staircase of those labels, with rails for long-reaching relations and folds over settled argument."
  bare
>
  <RailStage sugya={featured} />
</Layout>
