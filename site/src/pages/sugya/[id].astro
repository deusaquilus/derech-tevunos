---
import Layout from '../../layouts/Layout.astro';
import RailStage from '../../components/RailStage.astro';
import { SUGYOT } from '../../rail/sugyot/index.ts';
import { movementsOf } from '../../rail/sugya.ts';

export function getStaticPaths() {
  // Real pages, one per passage, generated from the same registry the
  // visualization reads. This is what replaces the app's `#/sugya/<id>` hash
  // route: the URL is crawlable, linkable and survives a reload.
  return SUGYOT.map((sugya) => ({
    params: { id: sugya.id },
    props: { sugya },
  }));
}

interface Props {
  sugya: (typeof SUGYOT)[number];
}

const { sugya } = Astro.props as Props;
const movements = movementsOf(sugya).length;
const cite = `${sugya.tractate} ${sugya.folio}`;
---

<Layout
  title={`${sugya.title} — ${cite} — Derech Tevunos`}
  description={`${cite}: ${sugya.units.length} labelled sentences in ${movements} movements, drawn as a waterfall of the moves each sentence makes.`}
  bare
>
  <RailStage sugya={sugya} />
</Layout>
