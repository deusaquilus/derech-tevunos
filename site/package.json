{
  "name": "derech-tevunos-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview",
    "generate": "npm run build-text && npm run build-search-index && npm run build-blog-lastmod && npm run glyphs",
    "build-text": "tsx scripts/build-text-docs.ts",
    "build-search-index": "tsx scripts/build-search-index.ts",
    "build-blog-lastmod": "tsx scripts/build-blog-lastmod.ts",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro",
    "check": "npm run typecheck && npm run check:rail",
    "check:rail": "tsx src/rail/check.ts",
    "glyphs": "tsx scripts/extract-glyphs.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^9.0.5",
    "astro": "^5.14.5",
    "fuse.js": "^7.1.0",
    "marked": "^17.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.10.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
