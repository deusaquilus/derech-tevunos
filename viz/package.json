{
  "name": "sugya-lattice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Categorize the sentences of a sugya using Ramchal's Derech Tevunos ch. 9 taxonomy and render them as a glyph lattice.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "export": "node src/main.ts",
    "glyphs": "node scripts/extract-glyphs.ts",
    "typecheck": "tsc --noEmit",
    "test": "node src/check.ts",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
